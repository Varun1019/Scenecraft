{
  "manifest_version": 3,
  "name": "Scenecraft Flow Connector",
  "version": "2.2",
  "description": "Side-panel extension for Google Flow with Scenecraft bridge, auto-recovery, and download automation.",
  "permissions": [
    "sidePanel",
    "downloads",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Flow Studio Side Panel"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/injected.js", "injected.js"],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ]
    }
  ]
}
